#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/queue.h"
#include "freertos/semphr.h"

//---------------- Configuración ----------------------------------//
#define SENSOR_1_PIN    4   // T0 es GPIO 4
#define SENSOR_2_PIN    27  // T7 es GPIO 27
#define QUEUE_SIZE      10
#define TASK_DELAY_MS   100

//-------------------- Estructuras --------------------------------//
typedef struct {
    uint32_t ts;    // Timestamp
    uint16_t val;   // Valor del sensor
    uint8_t  id;    // ID del sensor
} sensor_data_t;

// Estructura única para pasar parámetros a las tareas
typedef struct {
    int pin;
    QueueHandle_t cola;
    uint8_t id;
} config_t;

//-------------------- Recursos -----------------------------------//
QueueHandle_t q1, q2;
SemaphoreHandle_t mutex_serial;

//--- FUNCIÓN A: Lectura (Reutilizada para ambos sensores) --------//
void vTaskLectura(void *pvParameters) {
    config_t *cfg = (config_t *) pvParameters;
    sensor_data_t dato;

    for (;;) {
        // Lectura usando la API de Arduino para ESP32
        dato.val = touchRead(cfg->pin); 
        dato.ts  = millis();
        dato.id  = cfg->id;

        // Enviar a su cola independiente
        xQueueSend(cfg->cola, &dato, pdMS_TO_TICKS(10));
        
        vTaskDelay(pdMS_TO_TICKS(TASK_DELAY_MS));
    }
}

//--- FUNCIÓN B: Escritura JSON (Reutilizada para ambas colas) ----//
void vTaskEscritura(void *pvParameters) {
    config_t *cfg = (config_t *) pvParameters;
    sensor_data_t recibido;

    for (;;) {
        // Espera bloqueada hasta que lleguen datos a su cola
        if (xQueueReceive(cfg->cola, &recibido, portMAX_DELAY)) {
            
            // Protección de sección crítica (Serial) con Mutex
            if (xSemaphoreTake(mutex_serial, portMAX_DELAY) == pdTRUE) {
                
                // Salida en formato JSON
                Serial.printf("{\"sensor_id\":%d, \"lectura\":%d, \"timestamp\":%lu}\n",
                               recibido.id, recibido.val, recibido.ts);
                
                xSemaphoreGive(mutex_serial);
            }
        }
    }
}

//-----------------------------------------------------------------//
void setup() {
    Serial.begin(115200);

    // Crear colas independientes para cada flujo de datos
    q1 = xQueueCreate(QUEUE_SIZE, sizeof(sensor_data_t));
    q2 = xQueueCreate(QUEUE_SIZE, sizeof(sensor_data_t));
    
    // Crear Mutex para evitar corrupción de strings en el puerto Serial
    mutex_serial = xSemaphoreCreateMutex();

    // Configuración de parámetros (static para asegurar permanencia en memoria)
    static config_t c1 = { SENSOR_1_PIN, q1, 1 };
    static config_t c2 = { SENSOR_2_PIN, q2, 2 };

    // CREACIÓN DE LAS 4 TAREAS
    // Tareas de Lectura (Función A)
    xTaskCreate(vTaskLectura, "Lect_T0", 2048, &c1, 5, NULL);
    xTaskCreate(vTaskLectura, "Lect_T7", 2048, &c2, 5, NULL);

    // Tareas de Escritura (Función B)
    xTaskCreate(vTaskEscritura, "Write_1", 2048, &c1, 4, NULL);
    xTaskCreate(vTaskEscritura, "Write_2", 2048, &c2, 4, NULL);
}

void loop() {
    // El loop se suspende ya que FreeRTOS maneja las tareas
    vTaskDelete(NULL);
}